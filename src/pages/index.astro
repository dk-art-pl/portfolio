---
import projects from '../data/projects.js';
---

<!DOCTYPE html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DK-ART — Portfolio</title>
    <meta name="description" content="Profesjonalne portfolio fotograficzne i filmowe DK-ART Dariusz Kanclerz" />
    <style>
      body{background:#000;color:#fff;font-family:system-ui,-apple-system,sans-serif;margin:0}
      header{background:#111;padding:1.5rem 0}
      nav{max-width:80rem;margin:0 auto;padding:0 1rem;display:flex;justify-content:space-between;align-items:center}
      nav a:first-child{color:#fff;text-decoration:none;font-size:1.25rem;font-weight:700;letter-spacing:.05em}
      nav a:first-child:hover{color:#ccc}
      .nav-links{display:flex;gap:1.5rem}
      .nav-links a{color:#fff;text-decoration:none}
      .nav-links a:hover{color:#ccc}
      main{max-width:80rem;margin:0 auto;padding:3rem 1rem}
      .hero h1{font-size:2.25rem;font-weight:700;margin-bottom:.5rem}
      .hero p{font-size:1.25rem;color:#9ca3af}
      .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:1.5rem;margin-top:2rem}
      .card{display:block;text-decoration:none;color:inherit}
      .card-img{position:relative;overflow:hidden;border-radius:.5rem;aspect-ratio:16/9;background:#1f2937}
      .card-img img{width:100%;height:100%;object-fit:cover;transition:transform .3s}
      .card:hover .card-img img{transform:scale(1.05)}
      .card-overlay{position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.6),transparent)}
      .card-title{margin-top:.75rem;font-size:1.125rem;font-weight:600}
      .card:hover .card-title{color:#d1d5db}
      .card-desc{font-size:.875rem;color:#9ca3af}
      footer{background:#111;color:#9ca3af;padding:2rem 0;margin-top:4rem;text-align:center;font-size:.875rem}
      footer a{color:#9ca3af;text-decoration:none}
      footer a:hover{color:#fff}
    </style>
  </head>
  <body>
    <header>
      <nav>
        <a href="/">DK-ART</a>
        <div class="nav-links">
          <a href="https://www.instagram.com/dk.art_pl" target="_blank" rel="noopener">Instagram</a>
          <a href="https://www.behance.net/dk-art" target="_blank" rel="noopener">Behance</a>
          <a href="https://www.facebook.com/dkartcinema" target="_blank" rel="noopener">Facebook</a>
        </div>
      </nav>
    </header>
    <main>
      <div class="hero">
        <h1>DK-ART</h1>
        <p>Dariusz Kanclerz — Photography &amp; Film</p>
      </div>
      <div class="grid">
---
        {projects.map((project) => `
        <a href="/${project.slug}" class="card">
          <div class="card-img">
            <img src="${project.image}" alt="${project.title}" loading="lazy" />
            <div class="card-overlay"></div>
          </div>
          <h3 class="card-title">${project.title}</h3>
          <p class="card-desc">${project.description}</p>
        </a>`).join('\n')}
---
      </div>
    </main>
    <footer>
      <p>&copy; ${new Date().getFullYear()} DK-ART Dariusz Kanclerz. All rights reserved.</p>
      <div style="margin-top:1rem;display:flex;justify-content:center;gap:1.5rem">
        <a href="https://www.dk-art.pl" target="_blank">www.dk-art.pl</a>
      </div>
    </footer>
  </body>
</html>
