---
interface Props {
  project: {
    slug: string;
    title: string;
    description: string;
    image: string;
  };
}

const { project } = props;
---

<a href={`/${project.slug}`} class="group block">
  <div class="relative overflow-hidden rounded-lg aspect-[16/9] bg-gray-800">
    <img
      src={project.image}
      alt={project.title}
      loading="lazy"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
  </div>
  <h3 class="mt-3 text-lg font-semibold text-white group-hover:text-gray-300 transition">{project.title}</h3>
  <p class="text-sm text-gray-400">{project.description}</p>
</a>
